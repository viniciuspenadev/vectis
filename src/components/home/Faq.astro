---
import Icon from '../Icon.astro';
import { getLocale } from '../../i18n/utils';
import { homeCopy } from '../../i18n/home';
import { ui } from '../../i18n/ui';
import { site } from '../../data/site';

const locale = getLocale(Astro.url);
const t = homeCopy[locale].faq;
const waHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(ui[locale].whatsapp.message)}`;
---

<section id="faq" class="bg-mist-50 py-24 text-navy-900 md:py-32">
  <div class="container-x grid gap-12 lg:grid-cols-12">
    <div class="lg:sticky lg:top-32 lg:col-span-4 lg:self-start">
      <p class="eyebrow flex items-center gap-3 text-navy-600" data-reveal="left">
        {t.eyebrow}
      </p>
      <h2 class="heading-brand mt-6 text-[clamp(1.85rem,3.4vw,3rem)] text-navy-950" data-reveal>{t.title}</h2>
      <p class="mt-6 max-w-sm leading-relaxed text-steel-600" data-reveal data-reveal-delay="100">{t.text}</p>
      <a href={waHref} target="_blank" rel="noopener" class="btn btn-navy mt-10" data-reveal data-reveal-delay="150">
        <Icon name="whatsapp" size={16} />
        {t.cta}
      </a>
    </div>

    <div class="border-t border-navy-900/10 lg:col-span-7 lg:col-start-6" data-reveal data-reveal-delay="100">
      {
        t.items.map((item, i) => (
          <details name="faq" class="faq-item group border-b border-navy-900/10" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-7 [&::-webkit-details-marker]:hidden">
              <span class="flex items-baseline gap-5">
                <span class="font-display text-xs tracking-[0.2em] text-ice-600">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-lg font-medium text-navy-950 md:text-xl">{item.q}</span>
              </span>
              <span class="grid size-10 shrink-0 place-items-center rounded-full border border-navy-900/15 text-navy-800 transition-all duration-500 group-open:rotate-45 group-open:border-navy-900 group-open:bg-navy-900 group-open:text-white">
                <Icon name="plus" size={16} />
              </span>
            </summary>
            <p class="max-w-2xl pb-8 pl-10 leading-relaxed text-steel-600">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Abertura suave onde houver suporte (Chromium 131+); nos demais abre normalmente. */
  .faq-item::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.55s var(--ease-out-expo),
      content-visibility 0.55s allow-discrete;
  }

  .faq-item[open]::details-content {
    block-size: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item::details-content {
      transition: none;
    }
  }
</style>
