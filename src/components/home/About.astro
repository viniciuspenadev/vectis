---
/**
 * Manifesto da marca: a frase acende palavra por palavra conforme o scroll,
 * seguida dos 5 pilares (People, Expertise, Solutions, Movement, Opportunities).
 */
import { getLocale } from '../../i18n/utils';
import { homeCopy } from '../../i18n/home';

const t = homeCopy[getLocale(Astro.url)].about;
const words = t.statement.split(' ');
---

<section id="about" class="relative overflow-hidden bg-mist-100 text-navy-900">
  <div class="container-x py-24 md:py-32 lg:py-40">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-3">
        <p class="eyebrow flex items-center gap-3 text-navy-600" data-reveal="left">
          {t.eyebrow}
        </p>
      </div>

      <div class="lg:col-span-9">
        <h2 class="heading-brand text-[clamp(1.85rem,4.3vw,3.9rem)] !leading-[1.16] text-navy-950" data-words>
          {
            words.map((word, i) => (
              <span class="about-word" style={`--w:${i}`}>
                {word}{' '}
              </span>
            ))
          }
        </h2>

        <div class="mt-12 grid gap-8 md:mt-16 md:grid-cols-12 md:items-end">
          <p class="text-base leading-relaxed text-steel-600 md:col-span-7 md:text-lg" data-reveal>{t.text}</p>
          <p class="eyebrow text-navy-700 md:col-span-5 md:text-right" data-reveal data-reveal-delay="120">
            {t.signature}
          </p>
        </div>
      </div>
    </div>

    <ol class="mt-20 grid border-t border-navy-900/10 sm:grid-cols-2 sm:gap-x-10 lg:mt-28 lg:grid-cols-5 lg:gap-x-0">
      {
        t.pillars.map((pillar, i) => (
          <li
            class="border-b border-navy-900/10 py-8 lg:border-b-0 lg:border-l lg:px-7 lg:py-10 lg:first:border-l-0 lg:first:pl-0"
            data-reveal
            data-reveal-delay={i * 90}
          >
            <span class="font-display text-xs font-medium tracking-[0.2em] text-ice-600">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="eyebrow mt-5 !text-[13px] text-navy-950">{pillar.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-steel-600">{pillar.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .about-word {
    transition: color 0.5s ease;
  }

  :global(html.js) [data-words].is-ready .about-word {
    color: rgb(10 20 36 / 0.16);
  }

  :global(html.js) [data-words].is-ready .about-word.is-lit {
    color: var(--color-navy-950);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) [data-words].is-ready .about-word {
      color: var(--color-navy-950);
    }
  }
</style>

<script>
  const statement = document.querySelector<HTMLElement>('[data-words]');

  if (statement && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words = [...statement.querySelectorAll<HTMLElement>('.about-word')];
    let raf = 0;

    const update = () => {
      raf = 0;
      const rect = statement.getBoundingClientRect();
      const vh = window.innerHeight;
      // 0 quando o topo da frase entra a 85% da tela; 1 quando a base chega a 45%.
      const start = vh * 0.85;
      const end = vh * 0.45;
      const progress = Math.min(1, Math.max(0, (start - rect.top) / (start - end + rect.height)));
      const lit = Math.round(progress * words.length);
      words.forEach((w, i) => w.classList.toggle('is-lit', i < lit));
    };

    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };

    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) window.addEventListener('scroll', onScroll, { passive: true });
      else window.removeEventListener('scroll', onScroll);
      update();
    }).observe(statement);

    statement.classList.add('is-ready');
    update();
  }
</script>
