---
import Icon, { type IconName } from '../Icon.astro';
import { getLocale } from '../../i18n/utils';
import { homeCopy } from '../../i18n/home';

const t = homeCopy[getLocale(Astro.url)].industries;
---

<section id="industries" class="relative bg-mist-100 py-24 text-navy-900 md:py-32">
  <div class="container-x">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow flex items-center gap-3 text-navy-600" data-reveal="left">
          {t.eyebrow}
        </p>
        <h2 class="heading-brand mt-6 text-[clamp(1.85rem,3.8vw,3.35rem)] text-navy-950" data-reveal>
          {t.title[0]}<br /><span class="text-metal-dark">{t.title[1]}</span>
        </h2>
      </div>
      <p class="leading-relaxed text-steel-600 lg:col-span-4 lg:col-start-9" data-reveal data-reveal-delay="120">
        {t.text}
      </p>
    </div>

    <ul class="mt-14 grid gap-px border border-navy-900/10 bg-navy-900/10 sm:grid-cols-2 md:mt-20 lg:grid-cols-4">
      {
        t.items.map((item, i) => (
          <li class="ind-card group relative isolate flex flex-col overflow-hidden bg-mist-100 p-7 sm:min-h-[15.5rem] lg:p-8" data-reveal data-reveal-delay={(i % 4) * 80}>
            <div class="flex items-start justify-between">
              <span class="grid size-12 place-items-center rounded-full border border-navy-900/15 text-navy-700 transition-colors duration-500 group-hover:border-white/25 group-hover:text-ice-300">
                <Icon name={item.icon as IconName} size={20} />
              </span>
              <span class="font-display text-xs tracking-[0.2em] text-navy-900/40 transition-colors duration-500 group-hover:text-white/50">
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>
            <h3 class="eyebrow mt-auto pt-7 !text-[13px] sm:pt-10 text-navy-950 transition-colors duration-500 group-hover:text-white">
              {item.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-steel-600 transition-colors duration-500 group-hover:text-steel-300">
              {item.text}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ind-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(120% 80% at 100% 0%, rgb(47 166 240 / 0.22), transparent 55%),
      var(--color-navy-900);
    clip-path: inset(100% 0 0 0);
    transition: clip-path 0.7s var(--ease-out-expo);
  }

  .ind-card:hover::before {
    clip-path: inset(0 0 0 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .ind-card::before {
      transition: none;
    }
  }
</style>
